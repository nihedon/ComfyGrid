{
  "id": "bypasser",
  "name": "Bypasser",
  "version": "1.0.0",
  "description": "Custom toggle widget for bypasser node",
  "frontend": {
    "scripts": ["widget.js"],
    "widgets": [
      {
        "match": { "widget_class_name": "FastGroupsToggleRowWidget" },
